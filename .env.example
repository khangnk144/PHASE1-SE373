OPENAI_API_KEY=
OPENAI_BASE_URL=https://llm.uit.edu.vn/gemma/v1
MODEL_NAME=gemma-4-26b
# Leave empty on UIT network. Outside UIT: start scripts/start-tunnel.ps1 first.
UIT_PROXY=socks5://127.0.0.1:1081
MODEL_TIMEOUT_SECONDS=90
MODEL_MAX_TOKENS=3000
# Local demo explicitly permits pending drafts. Set 0 to require approved items.
ALLOW_DRAFT_BANK=1
# Unknown price: keep blank; logs report null, never claim free usage.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
